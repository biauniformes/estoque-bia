# --- Supabase (Project Settings > API) -----------------------------------------
# Públicas (podem ir para o navegador):
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# PRIVADA — somente servidor (Vercel: marque como "Sensitive"). NUNCA prefixe com NEXT_PUBLIC_.
# Usada para criar/desativar usuários pelo painel de Usuários e pelo script de seed.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Somente para `npm run seed` (dados fictícios) -----------------------------
# Senha dos 5 usuários de demonstração. Se vazio, o seed gera uma senha aleatória e a exibe uma vez.
SEED_PASSWORD=
